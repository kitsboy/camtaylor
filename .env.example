# Private preview defaults to true so a local build can never publish by accident.
# Production/public builds set VITE_PRIVATE_PREVIEW=false (see `npm run deploy:live`
# and docs/DEPLOYMENT.md).
VITE_PRIVATE_PREVIEW=true

# Formspree — the endpoint every contact-form submission is delivered to.
# The form must deliver to hello@giveabit.io: Kimi monitors that inbox, filters the
# spam and forwards genuine inquiries on to Cam, which is why the form is never
# pointed at Cam's own mailbox. Set that address as the form's recipient when you
# create it at https://formspree.io, then paste its ID here — the part after /f/ in
# the endpoint URL (https://formspree.io/f/abcdwxyz → abcdwxyz).
# `xykqodnk` below is the template's PLACEHOLDER, not a live form: with it in place
# the endpoint accepts a visitor's message and delivers it nowhere. The live ID is
# a build variable (`VITE_FORMSPREE_FORM_ID=… npm run build:live`, or the Cloudflare
# Pages production environment), and it is the only thing standing between this form
# and working.
VITE_FORMSPREE_FORM_ID=xykqodnk

# Optional — privacy-friendly analytics. No analytics is shipped at launch; if you
# enable one, also re-add its host to script-src and connect-src in public/_headers.
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
