# Private preview defaults to true so a local build can never publish by accident.
# Production/public builds set VITE_PRIVATE_PREVIEW=false (see `npm run deploy:live`
# and docs/DEPLOYMENT.md).
VITE_PRIVATE_PREVIEW=true

# Formspree — create a form at https://formspree.io for cam@camtaylor.ca
# Then paste your form ID (the part after /f/ in the endpoint URL)
VITE_FORMSPREE_FORM_ID=xykqodnk

# Optional — privacy-friendly analytics. No analytics is shipped at launch; if you
# enable one, also re-add its host to script-src and connect-src in public/_headers.
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
